# Copy to .env.local for local development. Do not commit secrets.

# Sanity (public — embedded at build time)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity (server)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Clerk — local/preview: pk_test_ / sk_test_ from Clerk Dashboard (Development)
# Clerk — Vercel Production: pk_live_ / sk_live_ from Clerk Dashboard (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Require Sanity staff email when 'true'
AUTH_GATED=false

# Optional: public site URL for Sanity Studio links
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
